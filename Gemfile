source "https://rubygems.org"

# Matches what GitHub Pages runs, so a local build behaves like production.
# See https://pages.github.com/versions/ for the current pinned set.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end

# Ruby 3.4 removed these from the default gems.
gem "csv"
gem "base64"
gem "bigdecimal"
